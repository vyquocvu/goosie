{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$(git rev-parse --show-toplevel)/scripts/verification_event.py\"", "timeout": 1800}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$(git rev-parse --show-toplevel)/scripts/verification_event.py\"", "timeout": 1800}
        ]
      }
    ]
  }
}
